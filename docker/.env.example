# Host port published by frontend/nginx (default 8000)
YORAWEALTH_PORT=8000

# External MySQL (not managed by Compose)
# Tailscale / LAN hostname, or host.docker.internal when MySQL is on the Docker host
DB_HOST=saravanas-mac-mini.tailfef550.ts.net
DB_PORT=3306
DB_USER=sysadmin
DB_PASSWORD=change-me
DB_NAME=yorawealth

DEBUG=false
SECRET_KEY=change-me-in-production
COOKIE_SECURE=false

# Comma-separated origins allowed for credentialed CORS
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://wealth.yoratech.com,https://wealth.yoratech.com
